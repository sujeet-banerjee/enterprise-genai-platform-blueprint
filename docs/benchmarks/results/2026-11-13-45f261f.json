    "config_snapshot": "# Showcase benchmark suites (issue #195, Workstream K).\n# Disabled by default: nothing runs unless a harness is invoked explicitly.\n#\n# Datasets are synthetic and committed under `benchmarks/data/` (see its README\n# for schema, provenance and licensing). Suites are bounded by\n# `max_combinations` and, for quick runs, `max_cases`.\n#\n# Run the report generator (issue #196):\n#   python -m app.benchmark_report --suite quick --config-dir config\nenabled: false\ndefault_suite: showcase\n\ndatasets:\n  enterprise-it:\n    path: benchmarks/data/enterprise-it/benchmark.json\n    domain: enterprise-it\n    description: \"Identity, RBAC, audit, crypto, resilience, vendor risk and FinOps\"\n  product-docs:\n    path: benchmarks/data/product-docs/benchmark.json\n    domain: product-docs\n    description: \"Fictional Atlas API platform documentation\"\n  support:\n    path: benchmarks/data/support/benchmark.json\n    domain: support\n    description: \"Support runbooks and FAQs\"\n\nsuites:\n  # Full reference run (local models). Bounded so it stays tractable on a CPU.\n  showcase:\n    description: \"All three corpora across the core retrieval levers\"\n    datasets: [enterprise-it, product-docs, support]\n    max_cases: 0\n    max_combinations: 24\n    parameters:\n      top_k: [3, 5]\n      reranker: [true, false]\n    objective:\n      quality: context_recall\n      cost_budget_usd: 0.01\n      latency_budget_ms: 1500\n\n  # Fast CI profile: dummy providers + a deterministic subset.\n  quick:\n    description: \"Bounded subset for CI and smoke runs\"\n    datasets: [support]\n    max_cases: 8\n    max_combinations: 4\n    parameters:\n      top_k: [3]\n      reranker: [false]\n    objective:\n      quality: context_recall\n\n  # Published reference run: real local models, all three corpora, bounded so it\n  # reproduces on a CPU in ~15 minutes. Results are committed under\n  # docs/benchmarks/results/ with provenance (see docs/benchmarks/methodology.md).\n  reference:\n    description: \"All three corpora, 6 cases each, top_k x reranker (real local models)\"\n    datasets: [enterprise-it, product-docs, support]\n    max_cases: 6\n    max_combinations: 4\n    parameters:\n      top_k: [3, 5]\n      reranker: [false, true]\n    objective:\n      quality: context_recall\n      cost_budget_usd: 0.01\n      latency_budget_ms: 1500\n",
