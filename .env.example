# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Used by deployment/docker-compose.yml (env_file) and local runs.

# --- Secrets (optional; absent => the corresponding provider is disabled) ---
# OpenAI-compatible provider (issue #13). Leave empty to stay fully local.
OPENAI_API_KEY=
# Hugging Face token for gated model downloads (issue #18). Optional.
HF_TOKEN=
# Static API key for the API-key gate / RBAC stub. Not read directly: reference
# it from config as ``api_key: env:GENAI_API_KEY`` (config/api.yaml) or in
# config/access_control.yaml ``api_keys``. Callers send it as X-API-Key.
GENAI_API_KEY=

# --- Config seam (issue #65) ---
# Point at a mounted config directory. Defaults to <repo>/config.
GENAI_CONFIG_DIR=

# --- Observability ---
# Prometheus /metrics needs the [observability] extra installed in the image
# (INSTALL_EXTRAS=".[observability]"); there is no env toggle (issue #44).
# OTLP trace export target (issue #47), used when observability.otel.enabled is
# true and ``otel.endpoint`` is left empty (the shipped default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Model cache ---
# Persist downloaded weights (mounted as a volume in compose).
HF_HOME=/app/.cache/huggingface
