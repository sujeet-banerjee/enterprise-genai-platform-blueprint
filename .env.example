# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Used by deployment/docker-compose.yml (env_file) and local runs.

# --- Secrets (optional; absent => the corresponding provider is disabled) ---
# OpenAI-compatible provider (issue #13). Leave empty to stay fully local.
OPENAI_API_KEY=
# Hugging Face token for gated model downloads (issue #18). Optional.
HF_TOKEN=
# Static API key required by the app's access control (core/services/access_control).
# Set to a strong random value; callers send it as the X-API-Key header.
GENAI_API_KEY=

# --- Config seam (issue #65) ---
# Point at a mounted config directory. Defaults to <repo>/config.
GENAI_CONFIG_DIR=

# --- Feature flags ---
# Expose the Prometheus /metrics endpoint (issue #44). Requires the
# [observability] extra to be installed in the image (INSTALL_EXTRAS).
GENAI_OBSERVABILITY=1
# OTLP trace export target (issue #47) when observability.otel.enabled=true.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Model cache ---
# Persist downloaded weights (mounted as a volume in compose).
HF_HOME=/app/.cache/huggingface
